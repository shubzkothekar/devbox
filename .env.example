# =============================================================================
# DevBox Development Container Environment Configuration
# Copy this file to .env and adjust as needed:
#   cp .env.example .env
#
# After modifying runtime flags or versions, rebuild the container:
#   docker compose up -d --build
# =============================================================================

# -----------------------------------------------------------------------------
# 1. User & Host Permissions
# -----------------------------------------------------------------------------
# Non-root container username
DEV_USERNAME=devbox

# Match your macOS host UID and GID to prevent file permission issues on mounts.
# Run `id -u` and `id -g` on your Mac to verify (typically 501 on macOS).
DEV_UID=501
DEV_GID=501

# Path to host public SSH key to authorize for instant passwordless login
SSH_PUBKEY_PATH=~/.ssh/id_ed25519.pub

# Host SSH port exposed for SSH connections (e.g. ssh -p 2222 devbox@localhost)
SSH_PORT=2222

# -----------------------------------------------------------------------------
# 2. Runtime Selection Flags (Enable / Disable Runtimes)
# -----------------------------------------------------------------------------
# Set to 'true' or 'false' to customize which toolchains are installed.
# Disabling unused runtimes creates smaller, faster-building container images.

# Golang Toolchain (go compiler, standard tools)
INSTALL_GO=true
GO_VERSION=1.24.5

# Node.js Runtime & Package Managers (node, npm, pnpm, yarn)
INSTALL_NODE=true
NODE_VERSION=22

# Python 3 Environment (python3, pip, venv, dev headers, pipx)
INSTALL_PYTHON=true

# Bun Runtime (bun, bunx) - ultra-fast all-in-one JavaScript runtime & bundler
INSTALL_BUN=false

# Rust Toolchain (rustup, rustc, cargo, rustfmt)
INSTALL_RUST=false

# Database & Cache CLI Utilities (MySQL client, MongoDB mongosh, Redis CLI)
INSTALL_DB_CLI=true

# NATS CLI Utility (nats)
INSTALL_NATS=true

# GitHub CLI Utility (gh)
INSTALL_GH=true

# GitLab CLI Utility (glab)
INSTALL_GLAB=true
GLAB_VERSION=1.118.0

# -----------------------------------------------------------------------------
# 3. Git Identity & Committer Configuration
# -----------------------------------------------------------------------------
# Automatically configures git config --global user.name / user.email and
# GIT_AUTHOR_NAME/EMAIL and GIT_COMMITTER_NAME/EMAIL for commits made inside the container.
GIT_USER_NAME="Your Name"
GIT_USER_EMAIL="you@example.com"

# -----------------------------------------------------------------------------
# 4. Git & Package Manager Authentication
# -----------------------------------------------------------------------------
# GitHub Personal Access Token (classic with repo scope or fine-grained)
# Required for cloning private repositories, pulling private Go/Node modules, and gh CLI.
GITHUB_TOKEN=
GH_TOKEN=

# GitLab Personal Access Token & host
GITLAB_TOKEN=
GLAB_TOKEN=
GITLAB_HOST=gitlab.com

# Default GitHub organization / prefix for private repositories
GIT_ORG=your-org

# Go private modules (comma-separated glob patterns)
GOPRIVATE=github.com/your-org/*
GOPROXY=https://proxy.golang.org,direct
GOTOOLCHAIN=auto

# -----------------------------------------------------------------------------
# 5. OpenVPN Network Configuration
# -----------------------------------------------------------------------------
# Automatically connect to OpenVPN on container boot if an .ovpn file exists in ./vpn/
AUTO_CONNECT_VPN=false

# -----------------------------------------------------------------------------
# 6. Named Volumes & Caching
# -----------------------------------------------------------------------------
GO_CACHE_NAME=devbox-go-cache
