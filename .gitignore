# =============================================================================
# DevBox Template Git Ignore Rules
# =============================================================================

# --- Environment & Sensitive Credentials ---
.env
*.env
!.env.example

# --- OpenVPN Private Profiles & Credentials ---
vpn/*.ovpn
vpn/*.crt
vpn/*.key
vpn/*.p12
vpn/auth.txt
!vpn/README.md
!vpn/.gitkeep

# --- Workspace Projects (Cloned or Mounted Repositories) ---
# Ignore code repositories inside workspace so this template repo stays clean
workspace/*
!workspace/.gitkeep
!workspace/README.md

# --- Docker & Compose Overrides ---
docker-compose.override.yml
*.log
logs/

# --- macOS System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# --- Editor Caches & Temporary Files ---
*.swp
*.swo
*~
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# --- Local Git Worktrees ---
.worktrees/

# --- DevBox Generated Files & Local Overrides ---
.generated/
.devcontainer/devcontainer.json
!.devcontainer/devcontainer.base.json
devbox.plugins.local.yml
